# Copy to .env.local and populate. Loaded by python-dotenv. Never commit .env.local.

# --- Local mock authentication (RULE 8: localhost only) ---
LOCAL_AUTH_BYPASS=true
LOCAL_AUTH_USER_ID=dev-admin-001
LOCAL_AUTH_USER_EMAIL=admin@obs.local
LOCAL_AUTH_USER_NAME=Local Admin

# --- Database engine ---
DB_ENGINE=duckdb
DUCKDB_PATH=./local-data/obs.duckdb

# --- Local filesystem landing zone (substitutes for Azure Blob Storage) ---
LANDING_ZONE_PATH=./local-data/landing-zone
ARCHIVE_PATH=./local-data/archive
ERROR_PATH=./local-data/error

# --- Pipeline alerts ---
ALERT_CHANNEL=console

# --- Notifications ---
NOTIFICATION_POLL_INTERVAL_SECONDS=60

# --- CORS / logging ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG
