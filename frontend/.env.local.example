# Copy to frontend/.env.local. Loaded by Vite. Never commit.
VITE_API_BASE_URL=http://localhost:8000
# false: skip OIDC, authenticate via the backend LOCAL_AUTH_BYPASS path (Local Dev §6.2).
# true: cloud BFF flow — login/refresh/logout go through /api/v1/auth/* (Security §6).
VITE_AUTH_ENABLED=false
# true: run the SPA against MSW mock handlers instead of the real API (Local Dev §10.3).
VITE_API_MOCK=false
