# infra/tier.env.example — copy to infra/tier.env and fill in real values.
# infra/tier.env is git-ignored; this template is committed.
# Quotes around placeholders let the file be sourced cleanly before you edit it.

# Shared
SUBSCRIPTION_ID="<subscription-id>"
AZURE_REGION="<azure-region>"
ENTRA_TENANT_ID="<tenant-id>"
ENTRA_CLIENT_ID="<client-id>"
ENTRA_CLIENT_SECRET="<client-secret>"

# Custom resource names (if empty, defaults to obs-val-${PHASE}-rg, obs-val-${PHASE}-rg-api, obs-val-${PHASE}-rg-swa)
# Allows friendly names like obs-validation instead of obs-val-1-rg-api
CUSTOM_APP_SERVICE_NAME=""
CUSTOM_SWA_NAME=""
# Backend API redirect URI — must match the app registration in Entra
# Format: https://<static-web-app-name>.azurestaticapps.net/api/v1/auth/callback
ENTRA_REDIRECT_URI=""
# Frontend Static Web Apps URL — where the SPA is deployed
# Format: https://<static-web-app-name>.azurestaticapps.net (or custom domain)
FRONTEND_BASE_URL=""

# PostgreSQL admin login — pinned to the literal mandated by Cloud Migration
# Spec v2.0 §3.2. The admin PASSWORD is never stored here: provision.sh generates
# it and writes it only to Key Vault as the obs-pg-connection-string secret.
PG_ADMIN_USER="obsadmin"

# Validation tier (cost-reduced, ephemeral)
VAL_PG_SKU="Standard_B1ms"
VAL_PG_TIER="Burstable"
VAL_PG_STORAGE="32"
VAL_PG_ZONAL="Disabled"
VAL_PG_BACKUP_RETENTION="7"
VAL_APP_SKU="B1"
VAL_APP_WORKERS="1"
VAL_BLOB_SKU="Standard_LRS"
VAL_SWA_SKU="Standard"
VAL_KV_RETENTION="7"

# Production tier (matches Cloud Migration Spec v2.0 §3 — do not weaken)
PROD_PG_SKU="Standard_D2s_v3"
PROD_PG_TIER="GeneralPurpose"
PROD_PG_STORAGE="128"
PROD_PG_ZONAL="Enabled"
PROD_PG_BACKUP_RETENTION="30"
PROD_APP_SKU="P2v3"
PROD_APP_WORKERS="2"
PROD_BLOB_SKU="Standard_ZRS"
PROD_SWA_SKU="Standard"
PROD_KV_RETENTION="90"
